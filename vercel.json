{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "functions": {
    "api/claude/v1/messages.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/download",
      "destination": "/api/download"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://getkipple.io/",
      "permanent": false
    },
    {
      "source": "/ru",
      "destination": "https://getkipple.io/ru/",
      "permanent": false
    },
    {
      "source": "/ru/:path*",
      "destination": "https://getkipple.io/ru/:path*",
      "permanent": false
    },
    {
      "source": "/privacy",
      "destination": "https://getkipple.io/privacy/",
      "permanent": false
    },
    {
      "source": "/privacy/:path*",
      "destination": "https://getkipple.io/privacy/:path*",
      "permanent": false
    },
    {
      "source": "/stats",
      "destination": "https://getkipple.io/stats/",
      "permanent": false
    },
    {
      "source": "/stats/:path*",
      "destination": "https://getkipple.io/stats/:path*",
      "permanent": false
    },
    {
      "source": "/img/:path*",
      "destination": "https://getkipple.io/img/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
