{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kipple",
  "version": "0.1.0",
  "identifier": "io.getkipple.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kipple",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: http: data: blob:; media-src 'self' asset: http://asset.localhost blob:; frame-src 'self' blob: asset: http://asset.localhost https://www.youtube-nocookie.com https://www.instagram.com https://player.vimeo.com https://www.tiktok.com; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/**",
            "$DOWNLOAD/**",
            "$DOCUMENT/**",
            "$DESKTOP/**",
            "$APPDATA/telegram-media/**"
          ],
          "deny": [
            "$HOME/.ssh",
            "$HOME/.ssh/**",
            "$HOME/.gnupg/**",
            "$DATA/Telegram Desktop/**",
            "$DATA/TelegramDesktop/**",
            "$APPDATA/Telegram Desktop/**",
            "$LOCALDATA/Telegram Desktop/**",
            "$HOME/.local/share/TelegramDesktop/**",
            "$LOCALDATA/Google/Chrome/**",
            "$LOCALDATA/Chromium/**",
            "$LOCALDATA/Microsoft/Edge/**",
            "$LOCALDATA/Yandex/**",
            "$LOCALDATA/BraveSoftware/**",
            "$LOCALDATA/Vivaldi/**",
            "$LOCALDATA/Mozilla/**",
            "$DATA/Mozilla/**",
            "$DATA/Opera Software/**",
            "$APPDATA/Mozilla/**",
            "$DATA/Google/Chrome/**",
            "$DATA/Chromium/**",
            "$DATA/Microsoft Edge/**",
            "$DATA/Firefox/**",
            "$DATA/Yandex/**",
            "$DATA/BraveSoftware/**",
            "$DATA/Arc/**",
            "$CONFIG/google-chrome/**",
            "$CONFIG/chromium/**",
            "$CONFIG/microsoft-edge/**",
            "$CONFIG/BraveSoftware/**",
            "$CONFIG/yandex-browser/**",
            "$CONFIG/opera/**",
            "$HOME/.mozilla/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Kipple",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English",
          "Russian"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    },
    "copyright": "© 2026 Kipple · Tame your kipple"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyRjZGRjJGQjZGNDJEODIKUldTQ0xmUzJMLy8yd29PSWhEajlndTRBR1gvYlZFU1dQQk80OEV0UVFkSUFkUzgvQkE3YU1paXYK",
      "endpoints": [
        "https://github.com/khainpain/kipple/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
