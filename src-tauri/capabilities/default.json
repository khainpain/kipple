{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "tg://resolve*"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$DESKTOP/**"
        },
        {
          "path": "$APPDATA/telegram-backup"
        }
      ],
      "deny": [
        {
          "path": "$HOME/.ssh"
        },
        {
          "path": "$HOME/.ssh/**"
        },
        {
          "path": "$HOME/.gnupg"
        },
        {
          "path": "$HOME/.gnupg/**"
        },
        {
          "path": "$DATA/Telegram Desktop/**"
        },
        {
          "path": "$DATA/TelegramDesktop/**"
        },
        {
          "path": "$LOCALDATA/Telegram Desktop/**"
        },
        {
          "path": "$HOME/.local/share/TelegramDesktop/**"
        },
        {
          "path": "$LOCALDATA/Google/Chrome/**"
        },
        {
          "path": "$LOCALDATA/Chromium/**"
        },
        {
          "path": "$LOCALDATA/Microsoft/Edge/**"
        },
        {
          "path": "$LOCALDATA/Yandex/**"
        },
        {
          "path": "$LOCALDATA/BraveSoftware/**"
        },
        {
          "path": "$LOCALDATA/Vivaldi/**"
        },
        {
          "path": "$LOCALDATA/Mozilla/**"
        },
        {
          "path": "$DATA/Mozilla/**"
        },
        {
          "path": "$DATA/Opera Software/**"
        },
        {
          "path": "$DATA/Google/Chrome/**"
        },
        {
          "path": "$DATA/Chromium/**"
        },
        {
          "path": "$DATA/Microsoft Edge/**"
        },
        {
          "path": "$DATA/Firefox/**"
        },
        {
          "path": "$DATA/Yandex/**"
        },
        {
          "path": "$DATA/BraveSoftware/**"
        },
        {
          "path": "$DATA/Arc/**"
        },
        {
          "path": "$CONFIG/google-chrome/**"
        },
        {
          "path": "$CONFIG/chromium/**"
        },
        {
          "path": "$CONFIG/microsoft-edge/**"
        },
        {
          "path": "$CONFIG/BraveSoftware/**"
        },
        {
          "path": "$CONFIG/yandex-browser/**"
        },
        {
          "path": "$CONFIG/opera/**"
        },
        {
          "path": "$HOME/.mozilla/**"
        }
      ]
    },
    "dialog:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$DESKTOP/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$DESKTOP/**"
        },
        {
          "path": "$APPDATA/telegram-media/**"
        }
      ]
    },
    {
      "identifier": "fs:scope",
      "deny": [
        {
          "path": "$HOME/.ssh"
        },
        {
          "path": "$HOME/.ssh/**"
        },
        {
          "path": "$HOME/.gnupg"
        },
        {
          "path": "$HOME/.gnupg/**"
        },
        {
          "path": "$DATA/Telegram Desktop/**"
        },
        {
          "path": "$DATA/TelegramDesktop/**"
        },
        {
          "path": "$LOCALDATA/Telegram Desktop/**"
        },
        {
          "path": "$HOME/.local/share/TelegramDesktop/**"
        },
        {
          "path": "$LOCALDATA/Google/Chrome/**"
        },
        {
          "path": "$LOCALDATA/Chromium/**"
        },
        {
          "path": "$LOCALDATA/Microsoft/Edge/**"
        },
        {
          "path": "$LOCALDATA/Yandex/**"
        },
        {
          "path": "$LOCALDATA/BraveSoftware/**"
        },
        {
          "path": "$LOCALDATA/Vivaldi/**"
        },
        {
          "path": "$LOCALDATA/Mozilla/**"
        },
        {
          "path": "$DATA/Mozilla/**"
        },
        {
          "path": "$DATA/Opera Software/**"
        },
        {
          "path": "$DATA/Google/Chrome/**"
        },
        {
          "path": "$DATA/Chromium/**"
        },
        {
          "path": "$DATA/Microsoft Edge/**"
        },
        {
          "path": "$DATA/Firefox/**"
        },
        {
          "path": "$DATA/Yandex/**"
        },
        {
          "path": "$DATA/BraveSoftware/**"
        },
        {
          "path": "$DATA/Arc/**"
        },
        {
          "path": "$CONFIG/google-chrome/**"
        },
        {
          "path": "$CONFIG/chromium/**"
        },
        {
          "path": "$CONFIG/microsoft-edge/**"
        },
        {
          "path": "$CONFIG/BraveSoftware/**"
        },
        {
          "path": "$CONFIG/yandex-browser/**"
        },
        {
          "path": "$CONFIG/opera/**"
        },
        {
          "path": "$HOME/.mozilla/**"
        }
      ]
    },
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-meta-recursive",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-rename",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
